<!DOCTYPE html>
<html>
<head>
    <title>Gallery of Bluesky/Hive AI Moderated Images</title>
    <link rel="stylesheet" type="text/css" href="style.css">
</head>
<body>

<div class="button-row">
{%- for n in range(page_count) %}
    <a href="gal-{{n+1}}.html"><button class="button {% if n+1 == page %}highlight{% endif %}">{{ n+1 }}</button></a> &nbsp;
{%- endfor %}
    &nbsp; Images {{ ((page-1)*30)+1 }} - {{ ((page-1)*30)+images|length }} of {{ total }}
</div>


<div class="gallery">
{%- for img in images %}
    <img src="{{ img }}">
{%- endfor %}
</div>

<script>
    window.onload = () => {
      for (let i of document.querySelectorAll(".gallery img")) {
        i.onclick = () => i.classList.toggle("full");
      }
    };
</script>
</body>
</html>
